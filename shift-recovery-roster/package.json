{
    "name": "shift-recovery-roster",
    "version": "1.0.0",
    "description": "Apify Actor that retrieves authorized scheduling/roster data and emits a normalized workforce dataset for an autonomous hospital shift-recovery agent.",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"{src,tests}/**/*.ts\" \"*.json\" \".actor/*.json\"",
        "format:check": "prettier --check \"{src,tests}/**/*.ts\" \"*.json\" \".actor/*.json\"",
        "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
        "start": "npm run start:dev",
        "start:dev": "npm run build && node dist/src/main.js",
        "start:prod": "node dist/src/main.js"
    },
    "dependencies": {
        "apify": "^3.2.6"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2"
    }
}
